# Set a long random secret for every deployment.
SESSION_SECRET=replace-with-a-long-random-secret
# Set DATABASE_URL for PostgreSQL. Without it, local PGlite stores data in ./data/medtrace.
# Copy the connection string from Supabase Connect. Use the session pooler when this host is IPv4-only.
# DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
# Supabase Auth and private Storage. Both keys are read only on the server.
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=medtrace-private
